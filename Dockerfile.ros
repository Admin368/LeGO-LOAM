FROM ros:melodic-ros-core-bionic

# Set non-interactive installation to avoid prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NONINTERACTIVE_SEEN=true
ENV TZ=America/New_York

# Install dependencies
RUN apt-get update && apt-get install -y \
    ros-melodic-cv-bridge \
    ros-melodic-tf \
    ros-melodic-message-filters \
    ros-melodic-image-transport \
    ros-melodic-pcl-ros \
    ros-melodic-rviz \
    libpcl-dev \
    libboost-all-dev \
    libeigen3-dev \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install GTSAM 4.0.0-alpha2
WORKDIR /tmp
RUN wget -q https://github.com/borglab/gtsam/archive/4.0.0-alpha2.zip && \
    unzip -q 4.0.0-alpha2.zip && \
    cd gtsam-4.0.0-alpha2 && \
    mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make -j2 && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf gtsam-4.0.0-alpha2 4.0.0-alpha2.zip

# Create catkin workspace
RUN mkdir -p /catkin_ws/src
WORKDIR /catkin_ws

# Source ROS
RUN echo "source /opt/ros/melodic/setup.bash" >> ~/.bashrc

CMD ["/bin/bash"]
